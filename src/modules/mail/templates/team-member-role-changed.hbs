<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Your Role Has Been Updated</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
</head>

<body style="margin:0;padding:0;background:#fdfcfb;font-family:'DM Sans', ui-sans-serif, system-ui, Arial, sans-serif;color:#2b2a29;">

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#fdfcfb;padding:40px 20px;">
    <tr>
        <td align="center">

            <table role="presentation" width="600" cellspacing="0" cellpadding="0" style="background:#ffffff;border-radius:10px;overflow:hidden;">

                <!-- Header -->
                <tr>
                    <td style="background:#16a34a;padding:24px;text-align:center;">
                        <h1 style="margin:0;color:#ffffff;font-size:24px;">
                            {{companyName}}
                        </h1>
                    </td>
                </tr>

                <tr>
                    <td style="padding:40px;">

                        <p style="margin-top:0;font-size:16px;">
                            Hello <strong>{{memberName}}</strong>,
                        </p>

                        <p style="font-size:15px;line-height:1.7;">
                            Your role at <strong>{{companyName}}</strong> has been updated to <strong>{{newRole}}</strong>.
                        </p>

                        <p style="font-size:15px;line-height:1.7;">
                            This change may affect the features and information you can access.
                            If you have any questions, please contact your administrator.
                        </p>

                        <!-- Role Details Box -->
                        <table width="100%" cellspacing="0" cellpadding="0" style="margin:30px 0;background:#f6f5f3;border:1px solid #e6e4df;border-radius:8px;">
                            <tr>
                                <td style="padding:20px;">

                                    <p style="margin:0 0 10px;">
                                        <strong>Your New Role</strong>
                                    </p>

                                    <p style="margin:0;font-size:18px;font-weight:bold;color:#16a34a;">
                                        {{newRole}}
                                    </p>

                                    {{#if memberEmail}}
                                    <p style="margin:20px 0 0 0; font-size:14px; color:#716f6b;">
                                        Connected account: {{memberEmail}}
                                    </p>
                                    {{/if}}

                                </td>
                            </tr>
                        </table>


                        <p style="font-size:15px;line-height:1.7;">
                            Need assistance? Contact us at
                            <a href="mailto:{{supportEmail}}" style="color:#16a34a;text-decoration:none;">
                                {{supportEmail}}
                            </a>.
                        </p>

                        <p style="margin-top:40px;">
                            Thank you for being part of <strong>{{companyName}}</strong>.
                        </p>

                        <p style="margin-top:24px;">
                            Kind regards,<br>
                            <strong>{{companyName}}</strong>
                        </p>

                    </td>
                </tr>

                <!-- Footer – clarifies sender identity -->
                <tr>
                    <td style="background:#f6f5f3;padding:20px;text-align:center;font-size:12px;color:#716f6b;line-height:1.6;">
                        This automated message was sent by <strong>SmartTrack</strong> on behalf of {{companyName}}.<br>
                        Please do not reply directly to this email.
                    </td>
                </tr>

            </table>

        </td>
    </tr>
</table>

</body>
</html>