<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Payment Failed</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
</head>
<body style="margin:0;padding:0;background:#fdfcfb;font-family:'DM Sans', ui-sans-serif, system-ui, Arial, sans-serif;color:#2b2a29;">

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#fdfcfb;padding:40px 20px;">
    <tr><td align="center">

        <table role="presentation" width="600" cellspacing="0" cellpadding="0" style="background:#ffffff;border-radius:10px;overflow:hidden;">

            <tr>
                <td style="background:#e85c13;padding:24px;text-align:center;">
                    <h1 style="margin:0;color:#ffffff;font-size:24px;">{{companyName}}</h1>
                </td>
            </tr>

            <tr>
                <td style="padding:40px;">

                    <p style="margin-top:0;font-size:16px;">Hello <strong>{{customerName}}</strong>,</p>

                    <p style="font-size:15px;line-height:1.7;">
                        We were unable to process the payment for your <strong>{{planName}}</strong> plan with {{companyName}}.
                    </p>

                    <p style="font-size:15px;line-height:1.7;">
                        Your access to paid features has been temporarily limited. To restore full access, please update your payment method or retry the payment.
                    </p>

                    <table width="100%" cellspacing="0" cellpadding="0" style="margin:30px 0;background:#f6f5f3;border:1px solid #e6e4df;border-radius:8px;">
                        <tr><td style="padding:20px;">
                            <p style="margin:0 0 10px;"><strong>Plan</strong></p>
                            <p style="margin:0;font-size:18px;font-weight:bold;color:#e85c13;">{{planName}}</p>
                        </td></tr>
                    </table>

                    <div style="text-align:center;margin:35px 0;">
                        <a href="{{renewalUrl}}" style="background:#e85c13;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:8px;font-weight:bold;display:inline-block;">
                            Manage Billing
                        </a>
                    </div>

                    <p style="font-size:15px;line-height:1.7;">
                        Need help? Contact us at <a href="mailto:{{supportEmail}}" style="color:#e85c13;text-decoration:none;">{{supportEmail}}</a>.
                    </p>

                    <p style="margin-top:40px;">Kind regards,<br><strong>{{companyName}}</strong></p>

                </td>
            </tr>

            <tr>
                <td style="background:#f6f5f3;padding:20px;text-align:center;font-size:12px;color:#716f6b;line-height:1.6;">
                    This automated message was sent by <strong>SmartTrack</strong> on behalf of {{companyName}}.<br>
                    Please do not reply directly to this email.
                </td>
            </tr>

        </table>

    </td></tr>
</table>
</body>
</html>