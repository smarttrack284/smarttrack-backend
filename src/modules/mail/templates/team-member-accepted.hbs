<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Team Member Joined</title>
    <!-- Import DM Sans for email clients that support web fonts -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
</head>

<body
        style="
    margin:0;
    padding:32px;
    background:#fdfcfb;
    font-family:'DM Sans', ui-sans-serif, system-ui, Arial, sans-serif;
    color:#2b2a29;
  "
>
<table
        role="presentation"
        cellpadding="0"
        cellspacing="0"
        width="100%"
>
    <tr>
        <td align="center">

            <table
                    role="presentation"
                    cellpadding="0"
                    cellspacing="0"
                    width="600"
                    style="
    background:#ffffff;
    border-radius:12px;
    overflow:hidden;
    border:1px solid #e6e4df;
  "
            >

                <!-- Header / Primary Brand Color -->
                <tr>
                    <td
                            style="
    background:#e85c13;
    color:#ffffff;
    padding:28px;
    text-align:center;
  "
                    >
                        <h1
                                style="
    margin:0;
    font-size:24px;
    font-weight:700;
  "
                        >
                            Team Member Joined
                        </h1>

                        <p
                                style="
    margin:10px 0 0;
    font-size:15px;
    color:#fdfcfb;
  "
                        >
                            A new member has successfully joined your workspace.
                        </p>
                    </td>
                </tr>

                <tr>
                    <td style="padding:32px;">

                        <p style="margin:0 0 18px;">
                            Hello,
                        </p>

                        <p style="margin:0 0 20px; line-height:1.7;">
                            <strong>{{memberName}}</strong> has accepted your invitation and is now a member of
                            <strong>{{companyName}}</strong>.
                        </p>

                        <!-- Member Details Box / Muted Background & Border -->
                        <table
                                role="presentation"
                                cellpadding="0"
                                cellspacing="0"
                                width="100%"
                                style="
    background:#f6f5f3;
    border:1px solid #e6e4df;
    border-radius:8px;
    margin:24px 0;
  "
                        >

                            <tr>
                                <td style="padding:18px;">

                                    <p style="margin:0 0 12px; color:#e85c13;">
                                        <strong>Member Details</strong>
                                    </p>

                                    <p style="margin:6px 0;">
                                        <strong>Name:</strong> {{memberName}}
                                    </p>

                                    <p style="margin:6px 0;">
                                        <strong>Email:</strong> {{memberEmail}}
                                    </p>

                                    <p style="margin:6px 0;">
                                        <strong>Role:</strong> {{roleLabel}}
                                    </p>

                                    <p style="margin:6px 0;">
                                        <strong>Joined:</strong> {{joinedAt}}
                                    </p>

                                </td>
                            </tr>

                        </table>

                        <!-- Call to Action / Primary Brand Color -->
                        <table
                                role="presentation"
                                cellpadding="0"
                                cellspacing="0"
                        >
                            <tr>
                                <td
                                        style="
    background:#e85c13;
    border-radius:8px;
  "
                                >

                                    <a
                                            href="{{teamUrl}}"
                                            style="
    display:inline-block;
    padding:14px 24px;
    color:#ffffff;
    text-decoration:none;
    font-weight:600;
    font-size:14px;
  "
                                    >
                                        View Team Members
                                    </a>

                                </td>
                            </tr>
                        </table>

                        <p
                                style="
    margin:28px 0 0;
    color:#716f6b;
    line-height:1.7;
  "
                        >
                            The new team member can now access your SmartTrack workspace according to the permissions assigned to their role.
                        </p>

                    </td>
                </tr>

                <!-- Footer – clarifies sender identity -->
                <tr>
                    <td style="padding:20px 32px;background:#f6f5f3;border-top:1px solid #e6e4df;text-align:center;font-size:12px;color:#716f6b;line-height:1.6;">
                        This automated message was sent by <strong>SmartTrack</strong> on behalf of {{companyName}}.<br>
                        Please do not reply directly to this email.
                    </td>
                </tr>

            </table>

        </td>
    </tr>
</table>
</body>
</html>