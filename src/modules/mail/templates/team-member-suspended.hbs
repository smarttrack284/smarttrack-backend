<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Team Member Suspended</title>
    <!-- Import DM Sans for email clients that support web fonts -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
</head>

<body
        style="
    margin:0;
    padding:32px;
    background:#fdfcfb;
    font-family:'DM Sans', ui-sans-serif, system-ui, Arial, sans-serif;
    color:#2b2a29;
  "
>
<table
        role="presentation"
        cellpadding="0"
        cellspacing="0"
        width="100%"
>
    <tr>
        <td align="center">

            <table
                    role="presentation"
                    cellpadding="0"
                    cellspacing="0"
                    width="600"
                    style="
    background:#ffffff;
    border-radius:12px;
    overflow:hidden;
    border:1px solid #e6e4df;
  "
            >

                <!-- Header / Primary Brand Color -->
                <tr>
                    <td
                            style="
    background:#e85c13;
    color:#ffffff;
    padding:28px;
    text-align:center;
  "
                    >
                        <h1
                                style="
    margin:0;
    font-size:24px;
    font-weight:700;
  "
                        >
                            Account Access Suspended
                        </h1>

                        <p
                                style="
    margin:10px 0 0;
    font-size:15px;
    color:#fdfcfb;
  "
                        >
                            Your workspace access status has changed.
                        </p>
                    </td>
                </tr>

                <tr>
                    <td style="padding:32px;">

                        <p style="margin:0 0 18px;">
                            Hello {{memberName}},
                        </p>

                        <p style="margin:0 0 20px; line-height:1.7;">
                            Your access to <strong>{{companyName}}</strong> has been temporarily suspended by a workspace administrator.
                        </p>

                        <!-- Suspension Details Box / Muted Background & Border -->
                        <table
                                role="presentation"
                                cellpadding="0"
                                cellspacing="0"
                                width="100%"
                                style="
    background:#f6f5f3;
    border:1px solid #e6e4df;
    border-radius:8px;
    margin:24px 0;
  "
                        >

                            <tr>
                                <td style="padding:18px;">

                                    <p style="margin:0 0 12px; color:#e85c13;">
                                        <strong>Suspension Details</strong>
                                    </p>

                                    <p style="margin:6px 0;">
                                        <strong>Workspace:</strong> {{companyName}}
                                    </p>

                                    <p style="margin:6px 0;">
                                        <strong>Suspended At:</strong> {{suspendedAt}}
                                    </p>

                                </td>
                            </tr>

                        </table>

                        <p
                                style="
    margin:28px 0 0;
    color:#716f6b;
    line-height:1.7;
  "
                        >
                            While suspended, you will not be able to log in or access resources within this workspace. If you believe this is a mistake, please reach out to your workspace administrator for assistance.
                        </p>

                    </td>
                </tr>

                <!-- Footer / Muted Background & Muted Text -->
                <tr>
                    <td
                            style="
    background:#f6f5f3;
    border-top:1px solid #e6e4df;
    padding:24px;
    font-size:13px;
    color:#716f6b;
    text-align:center;
    line-height:1.6;
  "
                    >
                        This notification was sent regarding your account status on SmartTrack.

                        <br><br>

                        © {{year}} SmartTrack
                    </td>
                </tr>

            </table>

        </td>
    </tr>
</table>
</body>
</html>