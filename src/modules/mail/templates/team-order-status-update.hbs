<!doctype html>
<html>
  <body
    style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:#18181b;"
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      style="background:#f4f4f5;padding:32px 16px;"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="600"
            cellspacing="0"
            cellpadding="0"
            style="max-width:600px;background:#ffffff;border-radius:12px;border:1px solid #e4e4e7;overflow:hidden;"
          >

            <!-- Header -->
            <tr>
              <td
                style="padding:28px 32px;border-bottom:1px solid #e4e4e7;"
              >
                <h2
                  style="margin:0;font-size:22px;color:#18181b;"
                >
                  {{companyName}}
                </h2>
                <p
                  style="margin:6px 0 0;font-size:14px;color:#71717a;"
                >
                  Order status notification
                </p>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding:32px;">
                <p
                  style="margin:0 0 16px;font-size:16px;line-height:1.6;"
                >
                  Hi {{memberName}},
                </p>

                <p
                  style="margin:0 0 20px;font-size:16px;line-height:1.6;"
                >
                  An order status has been updated in your workspace.
                </p>

                <div
                  style="padding:16px;background:#f8fafc;border:1px solid #e5e7eb;border-radius:8px;"
                >
                  <p
                    style="margin:0;font-size:14px;color:#71717a;"
                  >
                    Order
                  </p>

                  <p
                    style="margin:6px 0 16px;font-size:16px;font-weight:600;"
                  >
                    #{{orderReference}}
                  </p>

                  <p
                    style="margin:0;font-size:14px;color:#71717a;"
                  >
                    Customer
                  </p>

                  <p
                    style="margin:6px 0 16px;font-size:15px;"
                  >
                    {{customerName}}
                  </p>

                  <p
                    style="margin:0;font-size:14px;color:#71717a;"
                  >
                    Status Change
                  </p>

                  <p
                    style="margin:6px 0 0;font-size:15px;font-weight:600;"
                  >
                    {{previousStatus}} → 
                    <span style="color:#16a34a;">
                      {{statusLabel}}
                    </span>
                  </p>
                </div>

                <p
                  style="margin:24px 0;font-size:15px;line-height:1.6;color:#52525b;"
                >
                  Updated by: <strong>{{updatedBy}}</strong>
                </p>

                <table role="presentation" cellspacing="0" cellpadding="0">
                  <tr>
                    <td
                      style="background:#16a34a;border-radius:8px;"
                    >
                      <a
                        href="{{orderUrl}}"
                        style="display:inline-block;padding:12px 24px;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;"
                      >
                        View Order
                      </a>
                    </td>
                  </tr>
                </table>

                <p
                  style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#71717a;"
                >
                  This notification was sent to keep your team updated on
                  order activity. No action is required unless this change
                  requires follow-up.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="padding:20px 32px;background:#fafafa;border-top:1px solid #e4e4e7;text-align:center;font-size:12px;color:#71717a;"
              >
                {{companyName}} · Internal order notification
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>