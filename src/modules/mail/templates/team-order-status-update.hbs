<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Order Status Notification</title>
    <!-- Import DM Sans for email clients that support web fonts -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
</head>
<body
        style="margin:0;padding:0;background:#fdfcfb;font-family:'DM Sans', ui-sans-serif, system-ui, Arial, sans-serif;color:#2b2a29;"
>
<table
        role="presentation"
        width="100%"
        cellspacing="0"
        cellpadding="0"
        style="background:#fdfcfb;padding:32px 16px;"
>
    <tr>
        <td align="center">
            <table
                    role="presentation"
                    width="600"
                    cellspacing="0"
                    cellpadding="0"
                    style="max-width:600px;background:#ffffff;border-radius:12px;border:1px solid #e6e4df;overflow:hidden;"
            >

                <!-- Header -->
                <tr>
                    <td
                            style="padding:28px 32px;border-bottom:1px solid #e6e4df;"
                    >
                        <h2
                                style="margin:0;font-size:22px;color:#2b2a29;"
                        >
                            {{companyName}}
                        </h2>
                        <p
                                style="margin:6px 0 0;font-size:14px;color:#716f6b;"
                        >
                            Order status notification
                        </p>
                    </td>
                </tr>

                <!-- Content -->
                <tr>
                    <td style="padding:32px;">
                        <p
                                style="margin:0 0 16px;font-size:16px;line-height:1.6;"
                        >
                            Hi {{memberName}},
                        </p>

                        <p
                                style="margin:0 0 20px;font-size:16px;line-height:1.6;"
                        >
                            An order status has been updated in your workspace.
                        </p>

                        <!-- Order Details Box -->
                        <div
                                style="padding:16px;background:#f6f5f3;border:1px solid #e6e4df;border-radius:8px;"
                        >
                            <p
                                    style="margin:0;font-size:14px;color:#716f6b;"
                            >
                                Order
                            </p>

                            <p
                                    style="margin:6px 0 16px;font-size:16px;font-weight:600;"
                            >
                                #{{orderReference}}
                            </p>

                            <p
                                    style="margin:0;font-size:14px;color:#716f6b;"
                            >
                                Customer
                            </p>

                            <p
                                    style="margin:6px 0 16px;font-size:15px;"
                            >
                                {{customerName}}
                            </p>

                            <p
                                    style="margin:0;font-size:14px;color:#716f6b;"
                            >
                                Status Change
                            </p>

                            <p
                                    style="margin:6px 0 0;font-size:15px;font-weight:600;"
                            >
                                {{previousStatus}} →
                                <span style="color:#e85c13;">
                                    {{statusLabel}}
                                </span>
                            </p>
                        </div>

                        <p
                                style="margin:24px 0;font-size:15px;line-height:1.6;color:#716f6b;"
                        >
                            Updated by: <strong>{{updatedBy}}</strong>
                        </p>

                        <!-- Call to Action Button -->
                        <table role="presentation" cellspacing="0" cellpadding="0">
                            <tr>
                                <td
                                        style="background:#e85c13;border-radius:8px;"
                                >
                                    <a
                                            href="{{orderUrl}}"
                                            style="display:inline-block;padding:12px 24px;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;"
                                    >
                                        View Order
                                    </a>
                                </td>
                            </tr>
                        </table>

                        <p
                                style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#716f6b;"
                        >
                            This notification was sent to keep your team updated on
                            order activity. No action is required unless this change
                            requires follow-up.
                        </p>
                    </td>
                </tr>

                <!-- Footer – clarifies sender identity -->
                <tr>
                    <td style="padding:20px 32px;background:#f6f5f3;border-top:1px solid #e6e4df;text-align:center;font-size:12px;color:#716f6b;line-height:1.6;">
                        This automated message was sent by <strong>SmartTrack</strong> on behalf of {{companyName}}.<br>
                        Please do not reply directly to this email.
                    </td>
                </tr>

            </table>
        </td>
    </tr>
</table>
</body>
</html>